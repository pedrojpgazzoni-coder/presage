{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Presage",
  "version": "0.8.0",
  "identifier": "gg.presage.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Presage",
        "width": 1320,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Presage Overlay",
        "width": 300,
        "height": 340,
        "x": 24,
        "y": 120,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://ddragon.leagueoflegends.com data:; connect-src 'self' ipc: http://ipc.localhost https://ddragon.leagueoflegends.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCMDdBMzA5NEZFOTlDNUIKUldSYm5PbFBDYU1IeTZRV0lNK1d0My9KRWhJcWd6UndhU3lHSTdBbkhYSDVXSlZtbzdWa242emoK",
      "endpoints": [
        "https://github.com/pedrojpgazzoni-coder/presage/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}

